HOST=127.0.0.1
PORT=3002
APP_ORIGIN=http://127.0.0.1:3002
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=fenixa_app
MYSQL_PASSWORD=cambia_esta_clave
MYSQL_DATABASE=fenixa
UPLOAD_DIR=storage/files

# Almacenamiento de adjuntos: local (por defecto, carpeta UPLOAD_DIR) o supabase (bucket PRIVADO).
# STORAGE_DRIVER=local
# SUPABASE_URL=https://TU-PROYECTO.supabase.co
# SUPABASE_SERVICE_KEY=   # solo servidor; nunca en client/ ni en Git
# SUPABASE_BUCKET=nombre-del-bucket

# Si la app corre detrás de un proxy o túnel (Cloudflare, nginx), pon true o el número de saltos.
# Vacío o false = desactivado: Express ignora X-Forwarded-* (valor seguro por defecto).
TRUST_PROXY=false
