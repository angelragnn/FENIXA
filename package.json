{
  "name": "fenixa-full-stack",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Proyecto académico full stack con Express, MySQL, builds y documentos privados",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/server.mjs",
    "dev": "node --watch server/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "backup": "node scripts/backup.mjs",
    "restore:check": "node scripts/backup.mjs restore-check",
    "audit:files": "node scripts/audit-files.mjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "swagger-ui-express": "^5.0.1"
  }
}